# Cicero Baileys Admin Menu
# Salin ke .env, isi nilai rahasia, lalu set permission: chmod 600 .env

# ============================================================
# APLIKASI & KEAMANAN
# ============================================================
PORT=3016
CORS_ORIGIN=https://dashboard.example.com
ALLOW_DUPLICATE_REQUESTS=false
JWT_SECRET=ganti-dengan-random-secret-yang-kuat
SECRET_KEY=ganti-dengan-passphrase-enkripsi-yang-kuat
ADMIN_NOTIFY_LOGIN=true

# ============================================================
# DATABASE POSTGRESQL
# ============================================================
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cicero_db
DB_USER=cicero
DB_PASS=ganti-dengan-password-database

# ============================================================
# REDIS & MESSAGE QUEUE
# ============================================================
REDIS_URL=redis://127.0.0.1:6379
AMQP_URL=amqp://127.0.0.1

# ============================================================
# WHATSAPP / BAILEYS
# ============================================================
ADMIN_WHATSAPP=6281234567890
GATEWAY_WHATSAPP_ADMIN=6281234567890
WA_AUTH_DATA_PATH=/home/user/.cicero/baileys_auth
WA_AUTH_CLEAR_SESSION_ON_REINIT=false
WA_SERVICE_SKIP_INIT=false
WA_WEB_VERSION=
WA_WEB_VERSION_CACHE_URL=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/versions.json
WA_WWEBJS_PROTOCOL_TIMEOUT_MS=120000
WA_WWEBJS_PROTOCOL_TIMEOUT_MAX_MS=300000
WA_WWEBJS_PROTOCOL_TIMEOUT_BACKOFF_MULTIPLIER=1.5

# Opsi Baileys; hapus atau biarkan kosong untuk memakai default aplikasi.
WA_BAILEYS_SEND_BUDGET_MS=
WA_BAILEYS_SEND_RETRY_COUNT=
WA_BAILEYS_SEND_RETRY_DELAY_MS=
WA_MESSAGE_DEDUP_TTL_MS=86400000
WA_DEBUG_LOGGING=false

# ============================================================
# RAPIDAPI — INSTAGRAM & TIKTOK
# ============================================================
RAPIDAPI_KEY=
RAPIDAPI_FALLBACK_KEY=
RAPIDAPI_FALLBACK_HOST=
DEBUG_FETCH_INSTAGRAM=false
INSTAGRAM_LIKES_MAX_PAGES=0
INSTAGRAM_COMMENTS_MAX_PAGES=10
INSTAGRAM_COMMENTS_PAGE_DELAY_MS=3000

# ============================================================
# EMAIL / SMTP
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================================
# OPSIONAL
# ============================================================
COMPLAINT_RESPONSE_DELAY_MS=3000
DASHBOARD_PREMIUM_ALLOWED_TIERS=tier1,tier2,premium_1
